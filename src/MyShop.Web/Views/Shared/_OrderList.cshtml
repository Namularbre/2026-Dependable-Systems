@model IReadOnlyList<OrderDto>
@{
    var showUser = ViewData["ShowUser"] is true;
}

@foreach (var order in Model)
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between">
            <span>
                Order <code>@order.Id.ToString()[..8]</code> · @order.PlacedAt.ToLocalTime().ToString("g")
                @if (showUser)
                {
                    <span class="text-muted"> · user <code>@order.UserId.ToString()[..8]</code></span>
                }
            </span>
            <strong>@order.Total.ToString("C")</strong>
        </div>
        <ul class="list-group list-group-flush">
            @foreach (var line in order.Lines)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span>@line.Quantity × @line.ItemName <span class="text-muted">@@ @line.UnitPrice.ToString("C")</span></span>
                    <span>@line.Total.ToString("C")</span>
                </li>
            }
        </ul>
    </div>
}

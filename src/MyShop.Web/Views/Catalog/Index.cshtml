@model IReadOnlyList<ItemDto>
@{
    ViewData["Title"] = "Catalog";
}

<h1 class="mb-4">Catalog</h1>

@if (Model.Count == 0)
{
    <p class="text-muted">Nothing on sale right now. Come back soon!</p>
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">@item.Name</a>
                    </h5>
                    <p class="card-text text-muted">@item.Description</p>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <span class="fw-bold">@item.Price.ToString("C")</span>
                    <partial name="_AddToCart" model="item"/>
                </div>
            </div>
        </div>
    }
</div>

@model ItemEditViewModel
@{
    ViewData["Title"] = $"Backoffice · {Model.Item.Name}";
}

<h1 class="mb-1">@Model.Item.Name</h1>
<p class="text-muted small">
    Created @Model.Item.CreatedAt.ToLocalTime().ToString("g") · updated @Model.Item.UpdatedAt.ToLocalTime().ToString("g") ·
    @Model.Item.Stock in stock · @(Model.Item.IsPublished ? "on sale" : "hidden")
</p>

<div class="row g-5">
    <form asp-action="Edit" asp-route-id="@Model.Item.Id" method="post" class="col-md-7">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Form.Name" class="form-label"></label>
            <input asp-for="Form.Name" class="form-control"/>
            <span asp-validation-for="Form.Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Form.Description" class="form-label"></label>
            <textarea asp-for="Form.Description" class="form-control" rows="3"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="Form.Price" class="form-label"></label>
            <input asp-for="Form.Price" class="form-control" step="0.01" type="number"/>
            <span asp-validation-for="Form.Price" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-link">Back</a>
    </form>

    <div class="col-md-5">
        <h5>Stock history</h5>
        @if (Model.Movements.Count == 0)
        {
            <p class="text-muted">No stock movement yet.</p>
        }
        <ul class="list-group">
            @foreach (var m in Model.Movements)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span>@m.Reason <span class="text-muted small">@m.CreatedAt.ToLocalTime().ToString("g")</span></span>
                    <span class="@(m.Delta > 0 ? "text-success" : "text-danger")">@m.Delta.ToString("+0;-0")</span>
                </li>
            }
        </ul>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
